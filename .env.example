# Модель whisper: tiny/base/small/medium/large-v3 (medium — баланс качества и скорости на CPU)
WHISPER_MODEL=medium
LANGUAGE=ru
THREADS=8

# Telegram-бот: токен от @BotFather и ваш chat_id (узнать у @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Сколько дней хранить исходное аудио (расшифровки хранятся всегда)
AUDIO_RETENTION_DAYS=60

# DeepSeek для «причёсанной» версии расшифровки (platform.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Диаризация: auto — адаптивный подбор числа говорящих (рекомендуется),
# либо число — фиксированный порог кластеризации (меньше = больше говорящих)
DIAR_CLUSTER_THRESHOLD=auto

# Веб-страница загрузки (пусто = веб-интерфейс выключен)
WEB_LOGIN=
WEB_PASSWORD=
# Лимит размера файла для веб-загрузки, МБ
WEB_MAX_UPLOAD_MB=2048
# Белый список серийников диктофонов через запятую (пусто = принимать все)
ALLOWED_SN=
# Внешний URL страницы — подставляется в подсказку Telegram-бота
WEB_URL=
